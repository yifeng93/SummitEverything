4  + from summit_everything.domain.content import retrieval_eligibility, StorageArea
5  +
6  + root = Path.cwd()
7  + e = root / "docs/quality/reports/evidence/2026-10-11-stage-b-independent-ui-qa"
8  + w = root / ".local/qa-ui/workspace"
9  + p = root / ".local/qa-ui/profile"
10 + page = next(w.glob("合成*/*/*.md"))
11 + raw = page.read_text()
12 + _, fm, body = raw.split("---", 2)
13 + body = body.lstrip("\n")
14 + meta = yaml.safe_load(fm)
15 + gate = retrieval_eligibility(meta, body, area=StorageArea.FORMAL)
16 + assert gate.eligible
17 + source = next(w.glob("原件/*/*.md"))
18 + assert "24 人" in source.read_text()
19 + before = json.loads((e / "manifest-before-progress.json").read_text())
20 + confirmed = json.loads((e / "manifest-confirmed-not-executed.json").read_text())
21 + after = json.loads((e / "manifest-after-progress.json").read_text())
22 + assert before == confirmed
23 + assert (
24 +     before["projects"][0]["progress_version"] == 0 and after["projects"][0]["progress_version"] == 1
25 + )
26 + settings = json.loads(next(p.rglob("provider-settings.json")).read_text())
27 + assert settings["mode"] == "real"
28 + assert settings["feishu"]["app_id"] == "cli_synthetic_independent_ui"
29 + assert settings["feishu"]["real_data_enabled"] is False
30 + receipts = [
31 +     json.loads(x.read_text())
32 +     for x in (w / ".summit-everything/action_receipts/active").glob("*.json")
33 + ]
34 + assert len(receipts) == 3
35 + sqlite = sqlite3.connect(next(p.rglob("index.sqlite3")))
36 + tables = sqlite.execute("select name from sqlite_master where type='table'").fetchall()
37 + counts = {t[0]: sqlite.execute('select count(*) from "' + t[0] + '"').fetchone()[0] for t in tables}
38 + sqlite.close()
39 + requests = re.findall(
40 +     r'INFO: +127\.0\.0\.1:\d+ - "(\w+) ([^ ]+) HTTP/1\.1" (\d+)',
41 +     (root / ".local/qa-ui/browser-server.log").read_text(),
42 + )
43 + assert requests and all(
44 +     int(x[2]) < 400 or x == ("GET", "/api/v1/workspaces/current", "409") for x in requests
45 + )
46 + smoke = [x for x in requests if x[0] == "POST" and ("provider-smoke" in x[1] or "smoke" in x[1])]
47 + assert not smoke
48 + out = {
49 +     "workspace_id": after["workspace_id"],
50 +     "formal_file": str(page.relative_to(w)),
51 +     "eligibility": asdict(gate),
52 +     "source_count": 1,
53 +     "draft_count": len(list((w / ".summit-everything/drafts").glob("*.json"))),
54 +     "action_count": len(receipts),
55 +     "index_counts": counts,
56 +     "before_progress": before["projects"][0],
57 +     "after_progress": after["projects"][0],
58 +     "real_settings": settings,
59 +     "api_request_count": len(requests),
60 +     "smoke_post_count": len(smoke),
61 +     "assertions_pass": True,
62 + }
63 + (e / "disk-assertions.json").write_text(json.dumps(out, ensure_ascii=False, indent=2))
64 + (e / "loopback-api-requests.json").write_text(json.dumps(requests, indent=2))
65 + print(json.dumps(out, ensure_ascii=False, indent=2))
