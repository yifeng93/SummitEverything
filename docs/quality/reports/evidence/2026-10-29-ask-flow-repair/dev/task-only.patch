+        "related_project_id",
+        "text",
+        "source_statements",
+        "inferences",
+        "advice",
+        "missing_information",
+    }
+
+    def safe_location(location: object) -> str:
+        if not isinstance(location, tuple | list):
+            return "<root>"
+        parts: list[str] = []
+        for part in location[:8]:
+            if isinstance(part, int) and part >= 0:
+                parts.append(str(part))
+            elif isinstance(part, str) and part in known_fields:
+                parts.append(part)
