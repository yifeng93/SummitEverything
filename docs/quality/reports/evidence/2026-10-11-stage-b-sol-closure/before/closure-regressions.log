                result["value"] = _read_once(
                    client,
                    method,
                    url,
                    headers=headers,
                    params=params,
                    json_body=json_body,
                    files=files,
                    max_response_bytes=max_response_bytes,
                    timeout=effective,
                    deadline_at=deadline_at,
                    clock=clock,
                    response_box=response_box,
